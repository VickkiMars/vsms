# Production Containerfile for Vercel Container Deployments
FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy application source code
COPY . .

# Build Vite production bundle
RUN npm run build

# Configure container environment variables
ENV NODE_ENV=production
ENV PORT=80

# Expose default HTTP port
EXPOSE 80

# Start HTTP server listening on $PORT
CMD ["node", "server.js"]
